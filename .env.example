# ─────────────────────────────────────────────────────────────
# Движ-Патруль — переменные окружения
# Скопируйте в .env.local и заполните значениями своего проекта.
# .env.local НИКОГДА не коммитится.
# ─────────────────────────────────────────────────────────────

# Публичный адрес приложения. Используется для ссылок-приглашений
# и для абсолютных URL в метаданных. Без слэша в конце.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────
# Project Settings → API. Эти две переменные попадают в браузер,
# это нормально: anon key ограничен политиками RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. ТОЛЬКО сервер. Обходит RLS полностью.
# Никогда не добавляйте к нему префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Прямое подключение к Postgres. Нужно только для миграций
# и интеграционных тестов, приложению в рантайме не требуется.
DATABASE_URL=

# ─── Администратор ───────────────────────────────────────────
# Email аккаунта, которому выдаётся роль администратора при
# первом входе. Пользователь создаётся через Supabase Auth.
ADMIN_EMAIL=

# Секрет для подписи командных сессий (HMAC-SHA256).
# Сгенерировать: openssl rand -base64 48
# Минимум 32 символа. Смена секрета разлогинивает все команды.
SESSION_SECRET=

# ─── Gemini (AI-проверка) ────────────────────────────────────
# Всё опционально. Без ключа приложение работает полностью:
# фотографии уходят в ручную проверку организатору.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_VALIDATION_ENABLED=true
AI_ACCEPT_THRESHOLD=0.88
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_CONCURRENCY=4
AI_STALE_CHECK_MINUTES=5

# ─── Сессии, загрузки, хранение ──────────────────────────────
TEAM_SESSION_TTL_HOURS=72
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_MB=3
MAX_IMAGE_LONG_EDGE=1600
PHOTO_RETENTION_DAYS=30

# ─── Worker ──────────────────────────────────────────────────
# Общий секрет для защиты /api/worker/*. Запросы без него
# отклоняются. Сгенерировать: openssl rand -hex 32
WORKER_SECRET=

# ── Карта ─────────────────────────────────────────────────────
#
# Публичный токен Mapbox (начинается с pk.). Есть — карта рисуется
# на Mapbox: тёмная подложка, объёмные дома, наклон камеры. Нет —
# приложение само возвращается к Leaflet на тайлах OpenStreetMap,
# и это рабочий вариант, а не заглушка.
#
# Токен публичный по назначению — он уезжает в браузер, спрятать
# его нельзя и не нужно. Но ОБЯЗАТЕЛЬНО ограничьте его по адресам
# в дашборде Mapbox (Access tokens → URL restrictions), иначе
# вашу квоту потратит кто угодно.
NEXT_PUBLIC_MAPBOX_TOKEN=
