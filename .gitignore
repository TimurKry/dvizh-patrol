# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# образец переменных окружения коммитится
!.env.example

# артефакты прогонов Playwright: трассы, снимки, cookie сессии
/e2e-results/
/playwright-report/

# Промежуточные файлы записи ролика: сцены, куски монтажа, логи,
# бинарник PostgREST, файлы локального хранилища.
video-preview/scratch/

# Дорожка звука пересобирается детерминированно: npm run video:audio
video-preview/assets/audio/

# Служебный каталог Supabase CLI
supabase/.temp/
