# ─────────────────────────────────────────────────────────────
# Переменные записи ролика. Только имена — значений здесь нет и
# быть не должно.
#
# Стенд записи работает на локальной копии базы и к боевому
# проекту Supabase не обращается вовсе. Ключи локального стенда
# вычисляются в video-preview/stack/jwt.mjs из общеизвестного
# тестового секрета, поэтому в .env их класть не нужно.
# ─────────────────────────────────────────────────────────────

# Адрес приложения, с которого пишутся сцены.
APP_URL=

# Код demo-команды, которым Playwright входит в игру.
DEMO_JOIN_CODE=

# Учётная запись организатора на локальном стенде.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Секрет подписи локальных JWT. Не задан — берётся значение по
# умолчанию из stack/jwt.mjs. Боевой секрет сюда не подставлять.
LOCAL_JWT_SECRET=

# Строка подключения к локальному Postgres стенда.
DEMO_DATABASE_URL=

# Адрес локального Supabase-совместимого шима.
SHIM_URL=

# Путь к Chromium, если он лежит не там, где ждёт Playwright.
PLAYWRIGHT_CHROMIUM_PATH=

# X-дисплей для записи (Xvfb).
DISPLAY=

# Пересобрать список сцен: SCENES=map,hand — переснять только их.
SCENES=
